# Hugging Face Storage Bucket & Remote Setup
HF_BUCKET=hf://buckets/<YOUR_HF_USERNAME>/COD_dataset
HF_TOKEN=hf_your_huggingface_token_here


AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here


DATA_DIR=data/raw/dataset-splitM
MODEL_DIR=models
CHECKPOINT_DIR=models/raw_checkpoints
LOG_DIR=metrics

# Training Platform & Control
TRAINING_PLATFORM=huggingface
MODEL_VERSION=v1.0
RESUME=false

# MLflow Experiment Tracking Server
MLFLOW_TRACKING_URI=http://<YOUR_EC2_IP>:5000
MLFLOW_EXPERIMENT_NAME=COD-Camouflage-Detection

# MLflow S3 Artifact Storage (Attached Hugging Face S3 Bucket)
MLFLOW_S3_ENDPOINT_URL=https://s3.hf.co/<YOUR_HF_USERNAME>
AWS_ENDPOINT_URL_S3=https://s3.hf.co/<YOUR_HF_USERNAME>
AWS_DEFAULT_REGION=us-east-1
MLFLOW_ARTIFACT_LOCATION=s3://COD_dataset/dvc-store/mlflow-artifacts
HF_S3_URI=s3://COD_dataset/dvc-store


